# Canonical production URL (custom domain or Vercel default)
NEXT_PUBLIC_SITE_URL=https://ethanol-free-gas.vercel.app

# Google Search Console verification token (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: admin scripts only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox — optional; OSM fallback map works without this
NEXT_PUBLIC_MAPBOX_TOKEN=

# Web push (run: node scripts/generate-vapid-keys.mjs)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@ethanol-free-gas.vercel.app

# Optional: Google AdSense client ID for display ads
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Cron + admin (run: node scripts/generate-secrets.mjs)
CRON_SECRET=
IMPORT_CRON_KEY=
ADMIN_SECRET=

# Email (Resend) — premium inquiry + fuel alert emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=E0 Finder <alerts@yourdomain.com>
ADMIN_NOTIFY_EMAIL=

# OAuth (see scripts/setup-*-oauth.mjs)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# API licensing — comma-separated keys for /api/v1/stations
API_LICENSE_KEYS=

# Error monitoring (Sentry) — optional; app runs fine without it
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Rate limiting (Upstash Redis) — optional; limits no-op when unset
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Payments (Stripe) — optional; self-serve premium checkout when configured
# Set NEXT_PUBLIC_STRIPE_ENABLED=true to surface the "Subscribe with card" button
NEXT_PUBLIC_STRIPE_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
